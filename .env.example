# ---------- Core ----------
# Postgres. On Vercel: Storage -> Create Database -> Postgres, which sets this
# for you. Locally, `npm run db:local` uses SQLite instead and ignores this.
DATABASE_URL="postgresql://user:password@host:5432/mrsmoke?sslmode=require"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Uber Direct ----------
# https://developer.uber.com/docs/deliveries/get-started
UBER_CUSTOMER_ID=""
UBER_CLIENT_ID=""
UBER_CLIENT_SECRET=""
# "sandbox" uses Uber's test environment; "production" hits live couriers.
UBER_ENV="sandbox"
# Shared secret configured on the Uber webhook subscription
UBER_WEBHOOK_SECRET=""

# ---------- Stripe (optional; cash-only works without it) ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_ENABLED="false"

# ---------- fal.ai (creative generation, build-time only) ----------
FAL_KEY=""

# ---------- Store config ----------
STORE_NAME="Mr Smoke Et Slice"
STORE_ADDRESS="5518 Sherbrooke St W, Montreal, QC H4A 1W2"
STORE_PHONE="+15148265780"
STORE_LAT="45.4713"
STORE_LNG="-73.6157"
