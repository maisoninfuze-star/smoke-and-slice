{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/delivery/quote/route.ts": { "maxDuration": 15 },
    "src/app/api/orders/route.ts": { "maxDuration": 20 },
    "src/app/api/admin/orders/[id]/route.ts": { "maxDuration": 20 }
  }
}
