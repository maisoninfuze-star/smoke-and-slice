// Mr Smoke Et Slice — data model
//
// This file is the single source of truth and targets Postgres, which is what
// deploys. Vercel's filesystem is read-only and ephemeral, so SQLite cannot be
// used in production.
//
// The menu is NOT here — it lives in src/data/menu-data.ts and is read straight
// from that file, so the site can show a menu with no database at all. This
// schema covers only what genuinely needs persistence: orders, accounts,
// sessions and store settings.
//
// For zero-setup local work, `npm run db:local` derives a SQLite copy of this
// schema into prisma/.schema.local.prisma (provider line swapped, nothing else)
// so the two can never drift apart.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Home")
  line1     String
  line2     String?
  city      String  @default("Montréal")
  province  String  @default("QC")
  postal    String
  buzzer    String?
  notes     String?
  isDefault Boolean @default(false)

  @@index([userId])
}





model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest / contact details captured at checkout
  contactName     String
  contactPhone    String
  contactEmail    String?

  fulfilment      String      // PICKUP | DELIVERY
  status          String      @default("PENDING")
  // PENDING | CONFIRMED | PREPARING | READY | DISPATCHED | DELIVERED | COMPLETED | CANCELLED

  // Delivery address snapshot (nullable for pickup)
  addrLine1       String?
  addrLine2       String?
  addrCity        String?
  addrProvince    String?
  addrPostal      String?
  addrNotes       String?

  subtotalCents   Int
  deliveryCents   Int         @default(0)
  tipCents        Int         @default(0)
  tpsCents        Int         @default(0)  // GST 5%
  tvqCents        Int         @default(0)  // QST 9.975%
  totalCents      Int

  paymentMethod   String      @default("CASH") // CASH | CARD
  paymentStatus   String      @default("UNPAID") // UNPAID | PAID | REFUNDED
  stripeSessionId String?

  // Uber Direct
  uberQuoteId     String?
  uberDeliveryId  String?
  uberStatus      String?
  uberTrackingUrl String?
  courierName     String?
  courierPhone    String?
  courierLat      Float?
  courierLng      Float?
  etaAt           DateTime?

  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  events          OrderEvent[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Snapshot of the menu slug this line was ordered with. Not a foreign key:
  // the menu lives in src/data/menu-data.ts, so an item can be renamed or
  // retired without rewriting order history.
  menuItemId     String?
  nameSnapshot   String
  qty            Int
  unitPriceCents Int
  optionsJson    String   @default("[]") // [{name, priceCents}]
  lineTotalCents Int

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  dataJson  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model StoreSetting {
  id                  String  @id @default("singleton")
  acceptingOrders     Boolean @default(true)
  deliveryEnabled     Boolean @default(true)
  pickupEnabled       Boolean @default(true)
  deliveryRadiusKm    Float   @default(8)
  minDeliveryCents    Int     @default(1500)
  prepTimeMinutes     Int     @default(20)
  hoursJson           String  @default("[]")
}
